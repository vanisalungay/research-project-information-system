# =============================================================================
# RPIS front-end environment
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` (git-ignored) and adjust for your environment.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# =============================================================================

# Origin of the RPIS backend. The default matches `npm run dev` with the backend
# on its default port. Behind a load balancer, point this at the balancer (or at
# the gateway path that fronts the API) instead of at an individual instance -
# a per-instance URL would bypass the balancer and break failover.
VITE_API_BASE_URL=http://localhost:8081

# Request timeout in milliseconds. Without one a request against an overloaded or
# unreachable instance stays open until the browser's own very long default.
VITE_API_TIMEOUT_MS=30000
